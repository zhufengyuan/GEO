html body .ds-trend,
html body .ds-data,
html body .ds-card,
html body .ds-cta-btn,
html body .ds-empty {
  background: rgba(28, 38, 58, 0.82) !important;
  border: 1px solid rgba(59, 130, 246, 0.16) !important;
  color: #e2e8f0 !important;
}

/* 覆盖数据统计页 inline 渐变白底 */
html body .ds-head[style*="background"],
html body .ds-kpi-card[style*="background"],
html body .ds-trend[style*="background"],
html body .ds-card[style*="background"] {
  background: rgba(28, 38, 58, 0.82) !important;
}

html body .ds-head-title,
html body .ds-trend-title,
html body .ds-kpi-label,
html body .ds-ring-value,
html body .ds-empty-title,
html body .ds-card-title,
html body .ds-card-value,
html body .ds-leg,
html body .ds-cta-btn {
  color: #f1f5f9 !important;
}

html body .ds-kpi-badge,
html body .ds-mom,
html body .ds-trend-legend,
html body .ds-card-sub,
html body .ds-empty-desc {
  color: #94a3b8 !important;
}

html body .ds-mom-up {
  color: #4ade80 !important;
  background: rgba(34, 197, 94, 0.15) !important;
}

html body .ds-mom-down {
  color: #f87171 !important;
  background: rgba(239, 68, 68, 0.15) !important;
}

html body .ds-trend-plot {
  background: rgba(6, 12, 22, 0.60) !important;
  border: 1px solid rgba(59, 130, 246, 0.14) !important;
}

html body .ds-filter {
  background: rgba(6, 12, 22, 0.40) !important;
  border: 1px solid rgba(59, 130, 246, 0.18) !important;
  color: #94a3b8 !important;
}

html body .ds-filter.active,
html body .ds-filter:hover {
  background: linear-gradient(135deg, #2563eb, #3b82f6) !important;
  color: #fff !important;
  border-color: rgba(59, 130, 246, 0.50) !important;
}

html body .ds-view {
  background: rgba(6, 12, 22, 0.40) !important;
  border: 1px solid rgba(59, 130, 246, 0.18) !important;
  color: #94a3b8 !important;
}

html body .ds-view.active,
html body .ds-view:hover {
  background: linear-gradient(135deg, #6366f1, #7c3aed) !important;
  color: #fff !important;
  border-color: rgba(99, 102, 241, 0.50) !important;
}

html body .ds-card-kv {
  background: rgba(6, 12, 22, 0.60) !important;
  border: 1px solid rgba(59, 130, 246, 0.14) !important;
  color: #cbd5e1 !important;
}

/* ==================== 创建问题词库 (question-bank) ==================== */

html body .page-center .page-title[style*="color:#2563eb"],
html body .page-center .page-title[style*="color: #2563eb"] {
  color: #f1f5f9 !important;
}

html body .qb-label,
html body .qb-word-title,
html body .qb-dec-title {
  color: #f1f5f9 !important;
  font-weight: 700 !important;
}

html body .qb-right,
html body .qb-dec-item,
html body .qb-dec-desc {
  color: #e2e8f0 !important;
}

html body .qb-red {
  color: #f87171 !important;
}

html body .req {
  color: #f87171 !important;
}

/* 问题词库内的输入框已在全局 input 规则覆盖，这里做额外强化 */
html body .qb-input,
html body .qb-mini {
  background: rgba(6, 12, 22, 0.92) !important;
  border: 1px solid rgba(59, 130, 246, 0.28) !important;
  color: #f1f5f9 !important;
}

/* 问题词库卡片内的 table 文字 */
html body .question-bank .card table,
html body .question-bank .card th,
html body .question-bank .card td {
  color: #e2e8f0 !important;
}

/* 决策路径单选文字 */
html body .qb-dec-item span,
html body .qb-dec-item input[type="radio"] + span {
  color: #f1f5f9 !important;
}

/* 确保 question-bank 内所有文字不低于 #e2e8f0 */
html body .question-bank .card,
html body .question-bank .card div,
html body .question-bank .card span,
html body .question-bank .card label,
html body .question-bank .card p {
  color: inherit !important;
}
