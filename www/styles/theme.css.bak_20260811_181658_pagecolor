/* ================================================================
   时代科技 GEO优化后台 - 高端科技商务感主题 v2.0
   设计方向：深海蓝底色 + 电光蓝/青高亮 + 玻璃拟态 + 科技网格
   ================================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

:root {
  --spacing-nav-content: 26px;
  --spacing-block: 16px;
  --spacing-element: 12px;
  --font-title-primary: 18px;
  --font-title-secondary: 16px;
  --font-text-normal: 14px;
  --font-text-hint: 12px;

  /* ---- 高端科技商务配色 ---- */
  --color-title: #f1f5f9;
  --color-hint: #64748b;
  --color-expiry: #fbbf24;
  --color-text: #e2e8f0;
  --color-text-2: rgba(226, 232, 240, 0.72);
  --color-border: rgba(148, 163, 184, 0.12);
  --color-border-strong: rgba(148, 163, 184, 0.20);
  --color-surface: rgba(15, 23, 42, 0.60);
  --color-surface-glass: rgba(15, 23, 42, 0.55);
  --color-surface-2: rgba(30, 41, 59, 0.50);

  /* 主色：电光蓝→青色渐变 */
  --color-primary: #3b82f6;
  --color-primary-2: #2563eb;
  --color-primary-3: #06b6d4;
  --color-accent: #06b6d4;
  --color-accent-glow: rgba(6, 182, 212, 0.35);

  --shadow-sm: 0 4px 16px rgba(0, 0, 0, 0.30);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.45);
  --shadow-glow: 0 0 20px rgba(59, 130, 246, 0.25);

  --radius-sm: 8px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-pill: 999px;
  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);

  /* 科技网格背景 */
  --bg-grid: linear-gradient(rgba(59, 130, 246, 0.03) 1px, transparent 1px),
             linear-gradient(90deg, rgba(59, 130, 246, 0.03) 1px, transparent 1px);
  --bg-grid-size: 40px;
}

body {
  background: #060912;
  background-image: var(--bg-grid);
  background-size: var(--bg-grid-size) var(--bg-grid-size);
  color: var(--color-text);
  height: 100vh;
  overflow: hidden;
}

/* 全局渐变光晕装饰 */
body::before {
  content: "";
  position: fixed;
  top: -200px;
  left: -200px;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

body::after {
  content: "";
  position: fixed;
  bottom: -200px;
  right: -200px;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(6, 182, 212, 0.06) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.app {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

/* ==================== Header ==================== */
.header {
  min-height: 64px;
  background: rgba(10, 14, 26, 0.80);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 12px 24px;
  color: var(--color-title);
  box-shadow: 0 1px 0 rgba(59, 130, 246, 0.15), var(--shadow-sm);
  border-bottom: 1px solid rgba(59, 130, 246, 0.12);
  overflow: visible;
  position: relative;
  z-index: 100;
}

.header .logo {
  font-size: 18px;
  font-weight: 800;
  flex-shrink: 0;
  background: linear-gradient(135deg, #60a5fa 0%, #22d3ee 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 0.5px;
  position: relative;
  padding-left: 14px;
}

.header .logo::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4px;
  height: 20px;
  background: linear-gradient(180deg, #3b82f6 0%, #06b6d4 100%);
  border-radius: 2px;
  box-shadow: 0 0 8px rgba(59, 130, 246, 0.6);
}

.header .tip {
  font-size: 11px;
  margin: 0 16px 0 24px;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: rgba(148, 163, 184, 0.50);
  letter-spacing: 0.3px;
}

.header-right {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
  min-height: 36px;
}

.header .user {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: rgba(59, 130, 246, 0.12);
  border: 1px solid rgba(59, 130, 246, 0.25);
  color: #60a5fa;
  flex-shrink: 0;
  transition: all 0.2s var(--ease-out);
}

.header .user:hover {
  background: rgba(59, 130, 246, 0.20);
  box-shadow: 0 0 12px rgba(59, 130, 246, 0.30);
}

.header .sys-expiry {
  font-size: 11px;
  font-weight: 600;
  color: var(--color-expiry);
  padding: 4px 10px;
  border-radius: 6px;
  background: rgba(251, 191, 36, 0.08);
  border: 1px solid rgba(251, 191, 36, 0.15);
  flex-shrink: 0;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  min-height: 28px;
}

/* ==================== Container ==================== */
.container {
  display: flex;
  flex: 1;
  min-height: 0;
  gap: 0;
  overflow: hidden;
}

/* ==================== Sidebar ==================== */
.sidebar {
  width: 240px;
  background: rgba(10, 14, 26, 0.90);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-right: 1px solid rgba(59, 130, 246, 0.10);
  padding: 8px 8px 14px;
  overflow-y: auto;
  align-self: stretch;
  height: 100%;
  box-shadow: none;
  position: relative;
  z-index: 10;
}

.menu-section {
  padding: 4px 0;
}

.menu-section + .menu-section {
  margin-top: 8px;
  padding-top: 10px;
  border-top: 1px solid rgba(148, 163, 184, 0.06);
}

.menu-item {
  padding: 10px 14px 10px 44px;
  margin: 4px 4px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 10px;
  color: rgba(226, 232, 240, 0.65);
  cursor: pointer;
  transition: all 0.2s var(--ease-out);
  font-size: 13px;
  position: relative;
  user-select: none;
  letter-spacing: 0.2px;
}

.menu-item::before {
  content: "";
  width: 14px;
  height: 14px;
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  border-radius: 4px;
  background: rgba(148, 163, 184, 0.08);
  transition: all 0.2s var(--ease-out);
}

.menu-item:hover {
  background: rgba(59, 130, 246, 0.08);
  color: rgba(226, 232, 240, 0.85);
}

.menu-item:hover::before {
  background: rgba(59, 130, 246, 0.25);
}

.menu-item.active {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.95) 0%, rgba(6, 182, 212, 0.85) 100%);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.35), 0 0 1px rgba(6, 182, 212, 0.5);
}

.menu-item.active::before {
  background: rgba(255, 255, 255, 0.30);
  box-shadow: 0 0 6px rgba(255, 255, 255, 0.3);
}

.sub-menu {
  padding: 8px 14px 8px 56px;
  font-size: 12px;
  color: rgba(226, 232, 240, 0.45);
  cursor: pointer;
  transition: all 0.2s var(--ease-out);
  margin: 2px 4px;
  border-radius: 8px;
  position: relative;
  user-select: none;
}

.sub-menu::before {
  content: "";
  width: 5px;
  height: 5px;
  position: absolute;
  left: 30px;
  top: 50%;
  transform: translateY(-50%);
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.15);
  transition: all 0.2s var(--ease-out);
}

.sub-menu:hover {
  background: rgba(59, 130, 246, 0.06);
  color: rgba(226, 232, 240, 0.70);
}

.sub-menu:hover::before {
  background: var(--color-primary);
  box-shadow: 0 0 6px rgba(59, 130, 246, 0.5);
}

.sub-menu.active {
  background: rgba(59, 130, 246, 0.10);
  color: #60a5fa;
  font-weight: 600;
  border-left: 2px solid var(--color-primary);
  border-radius: 0 8px 8px 0;
  margin-left: 0;
  padding-left: 54px;
}

.sub-menu.active::before {
  background: var(--color-primary);
  box-shadow: 0 0 8px rgba(59, 130, 246, 0.6);
}

/* ==================== Main Content ==================== */
.main {
  flex: 1;
  padding: 20px 24px;
  min-width: 0;
  background: transparent;
  overflow-y: auto;
  overflow-x: hidden;
}

.content {
  width: 100%;
}

/* ==================== Card ==================== */
.card {
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: var(--radius-lg);
  padding: 24px;
  border: 1px solid rgba(59, 130, 246, 0.08);
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
  color: rgba(226, 232, 240, 0.92);
  transition: all 0.25s var(--ease-out);
}

.card:hover {
  box-shadow: var(--shadow-md), 0 0 1px rgba(59, 130, 246, 0.15);
  border-color: rgba(59, 130, 246, 0.15);
}

.card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.03) 0%, rgba(6, 182, 212, 0.02) 100%);
  pointer-events: none;
}

.card > * {
  position: relative;
  z-index: 1;
}

.dashboard-grid {
  display: grid;
  gap: 16px;
  align-items: stretch;
}

.stat-value {
  font-size: 22px;
  font-weight: 800;
  margin-top: 8px;
  background: linear-gradient(135deg, #60a5fa 0%, #22d3ee 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ==================== Badge ==================== */
.badge {
  display: inline-flex;
  align-items: center;
  height: 22px;
  padding: 0 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
  border: 1px solid var(--color-border);
  background: rgba(30, 41, 59, 0.60);
  color: #94a3b8;
  letter-spacing: 0.3px;
}

.badge-gray {
  background: rgba(51, 65, 85, 0.40);
  border-color: rgba(148, 163, 184, 0.15);
  color: #94a3b8;
}

.badge-green {
  background: rgba(16, 185, 129, 0.10);
  border-color: rgba(16, 185, 129, 0.25);
  color: #34d399;
}

.badge-red {
  background: rgba(239, 68, 68, 0.10);
  border-color: rgba(239, 68, 68, 0.25);
  color: #f87171;
}

.badge-blue {
  background: rgba(59, 130, 246, 0.10);
  border-color: rgba(59, 130, 246, 0.25);
  color: #60a5fa;
}

/* ==================== Page Layout ==================== */
.page-center {
  max-width: 980px;
  margin: 0 auto;
}

.page-shell {
  padding: 16px;
}

.page-shell .page-center {
  max-width: 100% !important;
  margin: 0 !important;
}

.page-muted {
  color: var(--color-hint);
  font-size: var(--font-text-hint);
}

.page-hint {
  color: #60a5fa;
  font-size: 13px;
}

.page-hint a {
  color: #60a5fa;
  text-decoration: none;
}

.page-hint a:hover {
  text-decoration: underline;
}

/* ==================== Action Row ==================== */
.action-row {
  display: flex;
  justify-content: center;
  margin: 18px 0;
}

.action-download-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  margin: 18px 0;
}

.action-download-row .big-action {
  transform: scale(0.8);
  transform-origin: right center;
}

@media (max-width: 900px) {
  .action-download-row {
    flex-direction: column;
    align-items: center;
  }
}

/* ==================== Big Action Button ==================== */
.big-action {
  padding: 8px 28px;
  border-radius: var(--radius-pill);
  border: 1px solid rgba(59, 130, 246, 0.20);
  background: rgba(15, 23, 42, 0.60);
  color: rgba(226, 232, 240, 0.85);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s var(--ease-out);
  letter-spacing: 0.5px;
}

.big-action:hover {
  background: rgba(59, 130, 246, 0.12);
  border-color: rgba(59, 130, 246, 0.35);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md), 0 0 16px rgba(59, 130, 246, 0.15);
}

/* ==================== Report ==================== */
.report {
  overflow: auto;
  max-height: calc(100vh - 280px);
  margin-top: 14px;
  border: 1px solid rgba(59, 130, 246, 0.08);
  border-radius: var(--radius-md);
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  min-height: 280px;
  position: relative;
  box-shadow: var(--shadow-sm);
}

.report-header {
  padding: 10px 14px;
  font-size: 12px;
  color: #64748b;
  border-bottom: 1px solid rgba(59, 130, 246, 0.06);
}

.report-body {
  overflow: auto;
  min-height: 200px;
}

.download {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  position: absolute;
  right: 12px;
  bottom: 12px;
  font-size: 13px;
  color: #60a5fa;
  cursor: pointer;
  user-select: none;
}

.download:hover {
  text-decoration: underline;
}

/* ==================== Section ==================== */
.section {
  margin-top: 18px;
}

.section-label {
  font-size: 13px;
  font-weight: 700;
  color: #f87171;
  margin: 10px 0 6px;
}

/* ==================== Textarea ==================== */
.textarea {
  overflow-x: auto;
  overflow-y: auto;
  width: 100%;
  min-height: 92px;
  resize: vertical;
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.50);
  padding: 10px 12px;
  font-size: 12px;
  color: #e2e8f0;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.20);
  transition: all 0.2s var(--ease-out);
}

.textarea:focus {
  outline: none;
  border-color: rgba(59, 130, 246, 0.45);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12), inset 0 1px 3px rgba(0, 0, 0, 0.20);
  background: rgba(15, 23, 42, 0.70);
}

.textarea-full {
  min-height: calc(100vh - 220px);
  resize: none;
}

.editor-shell {
  height: calc(100vh - 160px);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.editor-shell .textarea {
  overflow-x: auto;
  overflow-y: auto;
  flex: 1;
  min-height: 0;
}

@media (max-width: 900px) {
  .textarea-full {
    min-height: calc(100vh - 260px);
  }
  .editor-shell {
    height: calc(100vh - 220px);
  }
}

/* ==================== Pill Row ==================== */
.pill-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin: 10px 0;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: var(--radius-pill);
  background: rgba(30, 41, 59, 0.50);
  border: 1px solid rgba(148, 163, 184, 0.12);
  cursor: pointer;
  transition: all 0.2s var(--ease-out);
}

.pill.active {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.90) 0%, rgba(6, 182, 212, 0.80) 100%);
  border-color: rgba(59, 130, 246, 0.40);
  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.30);
  color: #ffffff;
}

.pill.active .pill-name,
.pill.active .pill-sub {
  color: #ffffff;
}

.pill.active .pill-icon {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
}

.pill:hover {
  transform: translateY(-1px);
  border-color: rgba(59, 130, 246, 0.20);
}

.pill-icon {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  background: rgba(59, 130, 246, 0.10);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #60a5fa;
  font-weight: 800;
  font-size: 12px;
  overflow: hidden;
}

.pill-icon-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  border-radius: inherit;
}

.ai-icon-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  border-radius: inherit;
}

.llm-svg-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.llm-fallback {
  width: 100%;
  height: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 12px;
  color: #60a5fa;
}

.icon-svg {
  width: 100%;
  height: 100%;
  display: block;
}

.pill-name {
  font-size: 12px;
  color: #cbd5e1;
  font-weight: 700;
}

.pill-sub {
  font-size: 11px;
  color: #64748b;
}

/* ==================== Loading & Empty ==================== */
.loading {
  padding: 24px;
  text-align: center;
  color: #64748b;
}

.empty {
  padding: 24px;
  text-align: center;
  color: #64748b;
}

/* ==================== Page Title ==================== */
.page-title {
  font-size: var(--font-title-primary);
  font-weight: 700;
  color: var(--color-title);
  margin-bottom: 10px;
}

.page-desc {
  color: rgba(226, 232, 240, 0.50);
  font-size: 14px;
}

.hidden {
  display: none;
}

/* ==================== Toolbar ==================== */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 14px;
}

.toolbar-left,
.toolbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.toolbar-right {
  justify-content: flex-end;
}

/* ==================== Buttons ==================== */
.btn-primary {
  padding: 6px 12px;
  border: 1px solid rgba(59, 130, 246, 0.15);
  border-radius: var(--radius-pill);
  background: rgba(30, 41, 59, 0.60);
  color: rgba(226, 232, 240, 0.85);
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s var(--ease-out);
  letter-spacing: 0.3px;
}

.btn-solid {
  padding: 6px 14px;
  border: 0;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
  color: #ffffff;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.30);
  transition: all 0.2s var(--ease-out);
  letter-spacing: 0.3px;
}

.btn-solid:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
  box-shadow: 0 6px 24px rgba(59, 130, 246, 0.40), 0 0 1px rgba(6, 182, 212, 0.5);
}

.btn-primary:hover {
  background: rgba(59, 130, 246, 0.10);
  border-color: rgba(59, 130, 246, 0.25);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.btn-solid:active,
.btn-primary:active,
.btn-icon:active,
.big-action:active,
.pill:active {
  transform: translateY(0);
  filter: brightness(0.95);
}

.btn-active,
button.btn-active {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.95) 0%, rgba(6, 182, 212, 0.85) 100%) !important;
  color: #ffffff !important;
  border-color: rgba(59, 130, 246, 0.40) !important;
}

button.btn-active:hover {
  filter: brightness(1.1);
}

.btn-icon {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  border: 1px solid rgba(59, 130, 246, 0.12);
  background: rgba(30, 41, 59, 0.60);
  color: rgba(226, 232, 240, 0.72);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s var(--ease-out);
}

.btn-icon:hover {
  background: rgba(59, 130, 246, 0.10);
  border-color: rgba(59, 130, 246, 0.25);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

/* ==================== Inputs ==================== */
.select,
.input {
  height: 34px;
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.15);
  background: rgba(15, 23, 42, 0.50);
  padding: 0 12px;
  font-size: 12px;
  color: #e2e8f0;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.20);
  transition: all 0.2s var(--ease-out);
}

.input::placeholder,
.textarea::placeholder {
  font-size: 12px;
  color: rgba(148, 163, 184, 0.40);
}

.select:focus,
.input:focus {
  outline: none;
  border-color: rgba(59, 130, 246, 0.45);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12), inset 0 1px 3px rgba(0, 0, 0, 0.20);
  background: rgba(15, 23, 42, 0.70);
}

.input {
  min-width: 260px;
}

/* ==================== Table ==================== */
.table-wrap {
  border-radius: var(--radius-md);
  overflow: auto;
  max-height: calc(100vh - 240px);
  border: 1px solid rgba(59, 130, 246, 0.08);
  background: rgba(15, 23, 42, 0.40);
  box-shadow: var(--shadow-sm);
}

.table-wrap.square {
  border-radius: 10px;
}

.note-box {
  border: 1px solid rgba(59, 130, 246, 0.10);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  background: rgba(15, 23, 42, 0.50);
  box-shadow: var(--shadow-sm);
}

.note-red {
  color: #f87171;
  font-size: 13px;
  line-height: 1.8;
}

/* ==================== Modal ==================== */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(6, 9, 18, 0.80);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.modal.show {
  display: flex;
}

.modal-card {
  width: min(980px, calc(100vw - 32px));
  max-height: calc(100vh - 32px);
  background: rgba(15, 23, 42, 0.90);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid rgba(59, 130, 246, 0.15);
  box-shadow: var(--shadow-lg), 0 0 40px rgba(59, 130, 246, 0.10);
}

.modal-head {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14px;
  background: linear-gradient(90deg, rgba(59, 130, 246, 0.95) 0%, rgba(6, 182, 212, 0.85) 100%);
  color: #fff;
  font-weight: 700;
  overflow: hidden;
  letter-spacing: 0.3px;
}

.modal-head > div {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.modal-body {
  padding: 14px;
  overflow: auto;
}

.modal-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  padding: 12px;
  border-top: 1px solid rgba(59, 130, 246, 0.08);
}

/* ==================== Thumbnail Grid ==================== */
.thumb-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.thumb {
  border: 1px solid rgba(59, 130, 246, 0.10);
  border-radius: 6px;
  height: 96px;
  background: rgba(30, 41, 59, 0.40);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 12px;
}

.u-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.u-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.u-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pill-small {
  padding: 6px 10px;
  border-radius: 2px;
  border: 1px solid rgba(148, 163, 184, 0.15);
  background: rgba(15, 23, 42, 0.60);
  font-size: 12px;
  color: #e2e8f0;
}

@media (max-width: 900px) {
  .thumb-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ==================== Table Styling ==================== */
table {
  width: 100%;
  border-collapse: collapse;
  table-layout: auto;
}

th,
td {
  border-bottom: 1px solid rgba(59, 130, 246, 0.06);
  padding: 12px 14px;
  font-size: 13px;
  color: #cbd5e1;
  text-align: left !important;
  white-space: nowrap;
  line-height: 1.6;
  vertical-align: middle;
}

.cell-wrap {
  white-space: normal !important;
  word-break: break-word;
  overflow: visible;
}

th {
  background: linear-gradient(180deg, rgba(59, 130, 246, 0.08) 0%, rgba(59, 130, 246, 0.02) 100%);
  color: #60a5fa;
  font-weight: 700;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  line-height: 1.25;
  word-break: break-word;
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: 0.5px;
}

tr:hover td {
  background: rgba(59, 130, 246, 0.04);
}

/* ==================== Scrollbar ==================== */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: rgba(15, 23, 42, 0.40);
  border-radius: 999px;
}

::-webkit-scrollbar-thumb {
  background: rgba(59, 130, 246, 0.20);
  border-radius: 999px;
  border: 2px solid rgba(15, 23, 42, 0.40);
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(59, 130, 246, 0.35);
}

/* ==================== Operation Links ==================== */
.op {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: auto;
  padding: 0;
  border-radius: 0;
  border: 0;
  background: transparent;
  color: #60a5fa;
  cursor: pointer;
  font-size: 12px;
}

.op:hover {
  text-decoration: underline;
}

.op-danger {
  color: #f87171;
}

.op-danger:hover {
  text-decoration: underline;
}

/* ==================== Responsive ==================== */
@media (max-width: 1024px) {
  .sidebar {
    width: 200px;
  }
}

@media (max-width: 900px) {
  body {
    height: auto;
    overflow: auto;
  }
  .app {
    height: auto;
  }
  .header .tip {
    display: none;
  }
  .container {
    flex-direction: column;
    position: static;
    overflow: visible;
  }
  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid rgba(59, 130, 246, 0.10);
    position: relative;
    transform: none;
    transition: none;
    box-shadow: none;
    height: auto;
  }
  .sidebar:hover {
    transform: none;
  }
  .main {
    padding-left: 20px;
    overflow: visible;
  }
}

